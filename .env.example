# PURPOSE: Documents required Docker Compose environment variables without real secrets.
# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (Docker TimescaleDB service)
DB_NAME=swarm
DB_USER=swarm
DB_PASSWORD=change-me-strong-database-password

# JWT signing key (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# First-run Control Center admin (created only when no CONTROL_CENTER_ADMIN exists)
SWARM_BOOTSTRAP_ADMIN_EMAIL=
SWARM_BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

# Optional MQTT (broker runs in Compose; app ingest stays off until enabled)
MQTT_ENABLED=false

# Optional emPOWER partner sandbox org/key (leave false on a clean start)
SWARM_PARTNER_SANDBOX_ENABLED=false
