# Raspberry Pi primary — copy to .env.rpi and fill in values. Never commit .env.rpi.

# --- Public URLs (Cloudflare Tunnel or LAN) ---
# ESP firmware and Connect Device need a URL reachable from your site network.
SWARM_PUBLIC_API_URL=https://api.swarm.co.in/api
VITE_API_URL=https://api.swarm.co.in/api
SAAS_APP_URL=https://app.swarm.co.in
CONTROL_CENTER_URL=https://control.swarm.co.in
CORS_ORIGINS=https://app.swarm.co.in,https://control.swarm.co.in,https://api.swarm.co.in,capacitor://localhost,https://localhost

# --- Database (local MySQL container) ---
DB_NAME=biopower_db
DB_USER=biopower
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# USB SSD mount on Pi (create directory first)
SWARM_MYSQL_DATA_DIR=/mnt/ssd/swarm/mysql

# --- Auth (must match Railway standby for JWT failover) ---
JWT_SECRET=your-shared-jwt-secret-min-256-bits

# --- Identity (local = SWARM login on app.swarm.co.in; saas needs SAAS_CLIENT_SECRET) ---
IDENTITY_MODE=local
SAAS_ACCOUNTS_URL=https://accounts.empowerapp.in
SAAS_CLIENT_ID=swarm_webapp

# --- Partner API (emPOWER integration) ---
# Sandbox org/key auto-seeded on first start when true (default). Set false on Railway standby.
SWARM_PARTNER_SANDBOX_ENABLED=true

# --- Railway standby sync (scripts/sync-to-railway.sh, scripts/daily-railway-sync.sh) ---
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_PORT=3306
RAILWAY_MYSQL_USER=root
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=railway
SYNC_BACKUP_DIR=/mnt/ssd/swarm/backups

# --- Railway API (daily sleep/wake — scripts/daily-railway-sync.sh) ---
# Create token: Railway → Account Settings → Tokens
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=b950f324-280f-4cce-aee6-147f0dfd08e5
RAILWAY_ENVIRONMENT_ID=
RAILWAY_MYSQL_SERVICE_ID=
RAILWAY_BACKEND_SERVICE_ID=
SYNC_SCHEDULE=daily

# --- Nova LLM (optional on Pi primary) ---
NOVA_SPACE_OP_ENABLED=true
NOVA_THINK_ENABLED=true
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
