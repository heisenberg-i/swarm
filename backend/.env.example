# PURPOSE: SWARM project file: .env.example
# PostgreSQL + TimescaleDB (never commit the password)
DB_HOST=192.168.29.229
DB_PORT=5433
DB_NAME=swarm
DB_USER=swarm_pi
DB_PASSWORD=

# First-boot Control Center admin (used only when no CONTROL_CENTER_ADMIN exists)
SWARM_BOOTSTRAP_ADMIN_EMAIL=
SWARM_BOOTSTRAP_ADMIN_PASSWORD=

# Opt-in demo SUPER_ADMIN logins (leave false in production)
SWARM_SEED_DEMO_ACCOUNTS=false
SWARM_SEED_DEMO_PASSWORD=

# LAN browser origins. true allows http(s)://* so login from a LAN IP is not 403.
SWARM_CORS_ALLOW_ANY_HTTP=true

# IoT ingest (device credentials migration)
# true = paired hubs with legacy_compat may POST /iot/batch with chipId only
SWARM_IOT_COMPAT_LEGACY=true
SWARM_IOT_MAX_READINGS=64
SWARM_RATE_INGEST_PER_MIN=120
SWARM_RATE_LOGIN_PER_MIN=20

# MQTT (optional — Mosquitto / EMQX). Keep false unless a broker is configured.
MQTT_ENABLED=false
MQTT_BROKER=tcp://localhost:1883
MQTT_SWARM_TOPIC=swarm/v1/+/+/+/telemetry
MQTT_USER=
MQTT_PASSWORD=

# Nova Space OP — LLM provider keys (DO NOT COMMIT — copy to backend/.env locally)
# Railway: set these in backend service Variables (never commit real keys to Git).

NOVA_SPACE_OP_ENABLED=true
NOVA_THINK_ENABLED=true
NOVA_NARRATE_ENABLED=true

# Groq (primary chain — OpenAI-compatible)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
NOVA_GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (failover chain)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
NOVA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Google Gemini (final failover — keys from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
NOVA_GEMINI_MODEL=gemini-2.0-flash

# Legacy single-slot (optional fallback)
NOVA_LLM_BASE_URL=https://api.groq.com/openai/v1
NOVA_LLM_API_KEY=
NOVA_LLM_MODEL=llama-3.3-70b-versatile
